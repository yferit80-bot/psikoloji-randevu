@{
    ViewData["Title"] = "Hasta Kayıt";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hasta Kayıt</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #3a7bd5, #6ea8fe);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .kart {
            background: white;
            border-radius: 20px;
            padding: 50px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2);
            max-width: 450px;
            width: 100%;
        }
        .form-control {
            border-radius: 10px;
            padding: 12px 15px;
            border: 2px solid #e0e0e0;
        }
        .form-control:focus {
            border-color: #3a7bd5;
            box-shadow: none;
        }
        .btn-kayit {
            background: linear-gradient(135deg, #3a7bd5, #6ea8fe);
            color: white;
            border: none;
            border-radius: 10px;
            padding: 12px;
            font-size: 1.1rem;
            font-weight: 600;
            width: 100%;
        }
        .btn-kayit:hover { opacity: 0.9; }
        .logo { color: #3a7bd5; font-size: 3rem; }
    </style>
</head>
<body>
    <div class="kart text-center">
        <i class="fas fa-heart logo mb-3"></i>
        <h2 class="fw-bold mb-1">Hasta Kayıt</h2>
        <p class="text-muted mb-4">Yeni hesap oluşturun</p>

        <form method="post" action="/Kayit/HastaKayit">
            <div class="mb-3 text-start">
                <label class="form-label fw-semibold">Ad</label>
                <input type="text" name="ad" class="form-control" placeholder="Adınız" required />
            </div>
            <div class="mb-3 text-start">
                <label class="form-label fw-semibold">Soyad</label>
                <input type="text" name="soyad" class="form-control" placeholder="Soyadınız" required />
            </div>
            <div class="mb-3 text-start">
                <label class="form-label fw-semibold">Email</label>
                <input type="email" name="email" class="form-control" placeholder="ornek@mail.com" required />
            </div>
            <div class="mb-4 text-start">
                <label class="form-label fw-semibold">Şifre</label>
                <input type="password" name="sifre" class="form-control" placeholder="••••••" required />
            </div>
            <button type="submit" class="btn-kayit mb-3">
                <i class="fas fa-user-plus me-2"></i>Kayıt Ol
            </button>
        </form>
        <a href="/Giris/HastaGiris" style="color:#3a7bd5; text-decoration:none; font-weight:500;">
            <i class="fas fa-arrow-left me-1"></i>Giriş sayfasına dön
        </a>
    </div>
</body>
</html>