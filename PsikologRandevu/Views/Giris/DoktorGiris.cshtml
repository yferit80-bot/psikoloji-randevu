@{
    ViewData["Title"] = "Doktor Girişi";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Doktor Girişi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #0f9b8e, #43c6ac);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .giris-kart {
            background: white;
            border-radius: 20px;
            padding: 50px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2);
            max-width: 450px;
            width: 100%;
        }
        .form-control {
            border-radius: 10px;
            padding: 12px 15px;
            border: 2px solid #e0e0e0;
        }
        .form-control:focus {
            border-color: #0f9b8e;
            box-shadow: none;
        }
        .btn-giris {
            background: linear-gradient(135deg, #0f9b8e, #43c6ac);
            color: white;
            border: none;
            border-radius: 10px;
            padding: 12px;
            font-size: 1.1rem;
            font-weight: 600;
            width: 100%;
        }
        .btn-giris:hover { opacity: 0.9; }
        .btn-geri {
            color: #0f9b8e;
            text-decoration: none;
            font-weight: 500;
        }
        .logo { color: #0f9b8e; font-size: 3rem; }
    </style>
</head>
<body>
    <div class="giris-kart text-center">
        <i class="fas fa-user-md logo mb-3"></i>
        <h2 class="fw-bold mb-1">Doktor Girişi</h2>
        <p class="text-muted mb-4">Hesabınıza giriş yapın</p>

        @if (ViewBag.Hata != null)
        {
            <div class="alert alert-danger">@ViewBag.Hata</div>
        }

        <form method="post" action="/Giris/DoktorGiris">
            <div class="mb-3 text-start">
                <label class="form-label fw-semibold">Email</label>
                <input type="email" name="email" class="form-control" placeholder="ornek@mail.com" required />
            </div>
            <div class="mb-4 text-start">
                <label class="form-label fw-semibold">Şifre</label>
                <input type="password" name="sifre" class="form-control" placeholder="••••••" required />
            </div>
            <button type="submit" class="btn-giris mb-3">
                <i class="fas fa-sign-in-alt me-2"></i>Giriş Yap
            </button>
        </form>
        <a href="/Giris" class="btn-geri">
            <i class="fas fa-arrow-left me-1"></i>Geri Dön
        </a>
    </div>
</body>
</html>