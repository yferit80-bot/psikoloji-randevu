@model IEnumerable<PsikologRandevu.Models.GorusmeNotlari>
@{
    ViewData["Title"] = "Görüşme Notları";
}

<div class="page-header">
    <h2><i class="fas fa-notes-medical me-2"></i>Görüşme Notları</h2>
    <p class="mb-0">Sistemdeki tüm görüşme notlarını buradan yönetebilirsiniz.</p>
</div>

<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Not Listesi</h5>
        <a href="/GorusmeNotu/Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Yeni Not</a>
    </div>
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Not</th>
                <th>Tarih</th>
                <th>İşlem</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var not in Model)
            {
                <tr>
                    <td>@not.Not</td>
                    <td><i class="fas fa-calendar me-2 text-muted"></i>@not.Tarih.ToShortDateString()</td>
                    <td>
                        <a href="/GorusmeNotu/Delete/@not.Id" class="btn btn-sm btn-danger">
                            <i class="fas fa-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>