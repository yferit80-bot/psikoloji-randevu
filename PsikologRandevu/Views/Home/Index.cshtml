@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="page-header">
    <h2><i class="fas fa-brain me-2"></i>Psikoloji Randevu Sistemi</h2>
    <p class="mb-0">Hoş geldiniz! Sistemi yukarıdaki menüden yönetebilirsiniz.</p>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="stat-card blue">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="mb-1 opacity-75">Kullanıcılar</p>
                    <h3>Yönet</h3>
                </div>
                <i class="fas fa-users"></i>
            </div>
            <a href="/Kullanici" class="btn btn-light btn-sm mt-3 w-100">Görüntüle</a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card teal">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="mb-1 opacity-75">Psikologlar</p>
                    <h3>Yönet</h3>
                </div>
                <i class="fas fa-user-md"></i>
            </div>
            <a href="/Psikolog" class="btn btn-light btn-sm mt-3 w-100">Görüntüle</a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card purple">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="mb-1 opacity-75">Hastalar</p>
                    <h3>Yönet</h3>
                </div>
                <i class="fas fa-heart"></i>
            </div>
            <a href="/Hasta" class="btn btn-light btn-sm mt-3 w-100">Görüntüle</a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card gray">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="mb-1 opacity-75">Randevular</p>
                    <h3>Yönet</h3>
                </div>
                <i class="fas fa-calendar-alt"></i>
            </div>
            <a href="/Randevu" class="btn btn-light btn-sm mt-3 w-100">Görüntüle</a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card p-4">
            <h5 class="mb-3"><i class="fas fa-bolt me-2 text-primary"></i>Hızlı İşlemler</h5>
            <div class="d-grid gap-2">
                <a href="/Kullanici/Create" class="btn btn-outline-primary"><i class="fas fa-user-plus me-2"></i>Yeni Kullanıcı Ekle</a>
                <a href="/Psikolog/Create" class="btn btn-outline-success"><i class="fas fa-user-md me-2"></i>Yeni Psikolog Ekle</a>
                <a href="/Hasta/Create" class="btn btn-outline-info"><i class="fas fa-heart me-2"></i>Yeni Hasta Ekle</a>
                <a href="/Randevu/Create" class="btn btn-outline-warning"><i class="fas fa-calendar-plus me-2"></i>Yeni Randevu Oluştur</a>
                <a href="/GorusmeNotu/Create" class="btn btn-outline-secondary"><i class="fas fa-notes-medical me-2"></i>Görüşme Notu Ekle</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-4">
            <h5 class="mb-3"><i class="fas fa-info-circle me-2 text-primary"></i>Sistem Hakkında</h5>
            <p class="text-muted">Bu sistem psikoloji kliniklerinde randevu ve hasta yönetimini kolaylaştırmak için geliştirilmiştir.</p>
            <ul class="list-unstyled">
                <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Kullanıcı yönetimi</li>
                <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Psikolog profil yönetimi</li>
                <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Hasta takibi</li>
                <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Randevu planlama</li>
                <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Görüşme notları</li>
            </ul>
        </div>
    </div>
</div>