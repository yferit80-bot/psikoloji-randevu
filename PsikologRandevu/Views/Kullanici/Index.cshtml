@model IEnumerable<PsikologRandevu.Models.Kullanicilar>
@{
    ViewData["Title"] = "Kullanıcılar";
}

<div class="page-header">
    <h2><i class="fas fa-users me-2"></i>Kullanıcılar</h2>
    <p class="mb-0">Sistemdeki tüm kullanıcıları buradan yönetebilirsiniz.</p>
</div>

<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Kullanıcı Listesi</h5>
        <a href="/Kullanici/Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Yeni Kullanıcı</a>
    </div>
    <table class="table table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Ad</th>
                <th>Soyad</th>
                <th>Email</th>
                <th>Rol</th>
                <th>İşlem</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var kullanici in Model)
            {
                <tr>
                    <td>@kullanici.Id</td>
                    <td>@kullanici.Ad</td>
                    <td>@kullanici.Soyad</td>
                    <td>@kullanici.Email</td>
                    <td><span class="badge bg-primary">@kullanici.Rol</span></td>
                    <td>
                        <a href="/Kullanici/Delete/@kullanici.Id" class="btn btn-sm btn-danger">
                            <i class="fas fa-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>